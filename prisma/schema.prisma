generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id               String            @id @default(cuid())
  name             String
  brand            String
  description      Json
  categories       Category[]
  images           Image[]
  specifications   Specification[]
  visibility       Json
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  supplierId       String
  sourceData       Json?
}

model Category {
  id        String   @id @default(cuid())
  type      String // 'style' | 'product_type'
  name      String
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, type, name])
}

model Image {
  id        String   @id @default(cuid())
  url       String
  source    String // 'supplier' | 'internal'
  isPrimary Boolean  @default(false)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Specification {
  id        String   @id @default(cuid())
  name      String
  value     String
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, name])
}

model Supplier {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  contact   Json?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
