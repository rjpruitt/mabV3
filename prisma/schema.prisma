// This is your Prisma schema file,
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // Short identifier
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  contacts SupplierContact[]
  products Product[]
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  // Contact Info
  name  String
  email String?
  phone String?

  // Role assignments
  roles SupplierContactRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
}

model SupplierContactRole {
  id        String          @id @default(cuid())
  contactId String
  contact   SupplierContact @relation(fields: [contactId], references: [id])

  // Role Info
  type      String // 'SALES', 'TECHNICAL_SUPPORT', 'INSTALLATION_SUPPORT', etc.
  isPrimary Boolean @default(false)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contactId, type]) // One role type per contact
  @@index([contactId])
  @@index([type, isPrimary]) // For finding primary contact for a role
}

model Product {
  id             String   @id @default(cuid())
  name           String
  brand          String
  description    Json     // Marketing, internal, and supplier descriptions
  categorization Json     // Product categorization data
  specifications Json     // Product specifications and features
  variations     Json?    // Product variations
  price          Decimal? @db.Decimal(10,2)
  designTool     Json?    // Design tool configuration

  // Relationships
  supplierId      String
  supplier        Supplier           @relation(fields: [supplierId], references: [id])
  images          ProductImage[]
  supplierPricing SupplierPricing?
  pricingConfig   PricingConfig?
  visibility      ProductVisibility?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  url        String
  alt        String?
  isPrimary  Boolean  @default(false)
  visibility ProductImageVisibility?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId])
}

model ProductImageVisibility {
  id        String       @id @default(cuid())
  imageId   String       @unique
  image     ProductImage @relation(fields: [imageId], references: [id])
  team      Boolean      @default(true)
  customer  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// Pricing Models
model SupplierPricing {
  id            String   @id @default(cuid())
  productId     String   @unique
  product       Product  @relation(fields: [productId], references: [id])
  listPrice     Decimal
  discount      Decimal?
  effectiveDate DateTime
  updatedAt     DateTime @updatedAt

  // Supplier reference data
  supplierSku         String?
  supplierName        String
  supplierProductName String?

  @@index([supplierName])
}

model PricingConfig {
  id          String   @id @default(cuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id])
  baseMarkup  Decimal
  tierMarkups Json // { [tierId: string]: number }
  adjustments Json // Array<{
  //   amount: number,
  //   reason: string,
  //   appliedBy: string,
  //   appliedDate: Date
  // }>
  updatedAt   DateTime @updatedAt
}

model PricingTier {
  id          String   @id
  name        String
  order       Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([order])
}

// Labor Pricing
model LaborPricing {
  id          String   @id @default(cuid())
  projectType String // e.g. 'tub-to-shower'
  baseLabor   Decimal
  tierRates   Json // {
  //   [tierId: string]: {
  //     laborCost: number,
  //     markup: number
  //   }
  // }
  factors     Json // Array<{
  //   id: string,
  //   description: string,
  //   adjustment: number,
  //   type: 'fixed' | 'percentage'
  // }>
  updatedAt   DateTime @updatedAt

  @@unique([projectType])
}

// Visibility & Access Control
model ProductVisibility {
  id          String   @id @default(cuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id])
  roles       String[] // Array of role IDs
  promotions  Json? // Array<{
  //   id: string,
  //   startDate?: Date,
  //   endDate?: Date,
  //   landingPages?: string[]
  // }>
  designTools Json? // Array<{
  //   id: string,
  //   pricingTiers: string[],
  //   isDefault?: boolean
  // }>
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// User & Lead Management
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  zipCode   String?
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  leads        Lead[]
  savedDesigns SavedDesign[]
}

model Lead {
  id               String     @id @default(cuid())
  userId           String?
  user             User?      @relation(fields: [userId], references: [id])
  name             String
  email            String
  phone            String
  zipCode          String
  projectTimeframe String // 'immediate', '1-3 months', etc.
  status           LeadStatus @default(NEW)
  source           String // 'design-tool', 'landing-page', etc.
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // Relationships
  savedDesign SavedDesign?

  @@index([email])
  @@index([userId])
}

// Design Storage
model SavedDesign {
  id     String  @id @default(cuid())
  name   String?
  userId String?
  user   User?   @relation(fields: [userId], references: [id])
  leadId String? @unique // One design per lead
  lead   Lead?   @relation(fields: [leadId], references: [id])

  // Design Configuration
  projectType String // 'tub-to-shower', etc.
  components  Json // Selected products and options
  pricing     Json? // Cached price calculation

  // Pre-configured design fields
  isTemplate   Boolean @default(false)
  templateData Json? // {
  //   displayName: string,
  //   description: string,
  //   promotionIds: string[],
  //   designToolIds: string[],
  //   pricingTiers: string[]
  // }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isTemplate])
}

enum UserRole {
  CUSTOMER
  SALES_REP
  ADMIN
}

enum LeadStatus {
  NEW
  CONTACTED
  APPOINTMENT_SET
  QUOTED
  SOLD
  LOST
}
